{
  "expo": {
    "name": "Parti2",
    "slug": "parti2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parti2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bara1021.parti2",
      "supportsTablet": false
    },
    "android": {
      "package": "com.bara1021.parti2",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E14",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E14",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
